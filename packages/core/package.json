{
  "name": "@agent-devtools/core",
  "version": "0.1.0",
  "description": "Framework-neutral ADP client, query and snapshot diff helpers",
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": { "prepack": "pnpm build",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": { "@agent-devtools/protocol": "workspace:^" },
  "devDependencies": { "tsup": "^8.5.0", "typescript": "catalog:" },
  "license": "MIT"
}
